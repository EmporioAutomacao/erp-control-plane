# ── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=gere-com-python-c-secrets-token-hex-50
DEBUG=false
# Domínio público do Control Plane (usado no Traefik e no ALLOWED_HOSTS)
CP_DOMAIN=ararasuite.com.br

# ── Banco de dados ───────────────────────────────────────────────────────────
POSTGRES_DB=erp_cp
POSTGRES_USER=erp_cp
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── E-mail ───────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@ararasuite.com.br

# ── Provisionamento ──────────────────────────────────────────────────────────
# Diretório no host Swarm manager onde ficam os stacks dos clientes
TENANTS_BASE_PATH=/opt/tenants
# Domínio base dos subdomínios dos clientes (ex: cliente.ararasuite.com.br)
ERP_DOMAIN=ararasuite.com.br
# Domínio usado na landing page para preview de subdomínio
SAAS_DOMAIN=ararasuite.com.br
# Versão do ERP provisionada para novos clientes
ERP_LATEST_VERSION=latest
# false em dev local (sem Traefik/subdomínio roteável)
PROVISIONING_CHECK_HTTP=false

# ── Produção ─────────────────────────────────────────────────────────────────
# Versão da imagem do control plane usada no stack-prod.yml
CP_VERSION=0.0.1
# Workers do Gunicorn (recomendado: 2 × CPUs + 1)
GUNICORN_WORKERS=3
